# ============================================================
# Biến môi trường app cần (tiêu chí 9). KHÔNG ghi secret thật ở đây.
# Dùng: cp .env.example .env   (file .env đã nằm trong .gitignore)
# ============================================================

# Platform / server
PORT=8000
ENVIRONMENT=development

# Security — API key (đặt giá trị thật trên platform, KHÔNG commit)
AGENT_API_KEY=dev-key-change-me

# Redis (rate limit + cost guard dùng chung)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard: ngân sách tối đa (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=30.0
